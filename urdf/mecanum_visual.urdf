<?xml version="1.0"?>
<robot name="xgc2_mecanum_ugv">
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecanum_description/meshes/nexus_base_link.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="body"><color rgba="0.9 0.8 0.6 1"/></material>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="upper_left_wheel">
    <visual><geometry><mesh filename="package://mecanum_description/meshes/mecanum_wheel_left.STL" scale="0.001 0.001 0.001"/></geometry></visual>
  </link>
  <joint name="upper_left_wheel_joint" type="continuous">
    <origin xyz="0.150 0.150 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/><child link="upper_left_wheel"/><axis xyz="0 1 0"/>
  </joint>

  <link name="lower_left_wheel">
    <visual><geometry><mesh filename="package://mecanum_description/meshes/mecanum_wheel_right.STL" scale="0.001 0.001 0.001"/></geometry></visual>
  </link>
  <joint name="lower_left_wheel_joint" type="continuous">
    <origin xyz="-0.150 0.150 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/><child link="lower_left_wheel"/><axis xyz="0 1 0"/>
  </joint>

  <link name="upper_right_wheel">
    <visual><geometry><mesh filename="package://mecanum_description/meshes/mecanum_wheel_right.STL" scale="0.001 0.001 0.001"/></geometry></visual>
  </link>
  <joint name="upper_right_wheel_joint" type="continuous">
    <origin xyz="0.150 -0.150 0.05" rpy="3.141592653589793 0 0"/>
    <parent link="base_footprint"/><child link="upper_right_wheel"/><axis xyz="0 1 0"/>
  </joint>

  <link name="lower_right_wheel">
    <visual><geometry><mesh filename="package://mecanum_description/meshes/mecanum_wheel_left.STL" scale="0.001 0.001 0.001"/></geometry></visual>
  </link>
  <joint name="lower_right_wheel_joint" type="continuous">
    <origin xyz="-0.150 -0.150 0.05" rpy="3.141592653589793 0 0"/>
    <parent link="base_footprint"/><child link="lower_right_wheel"/><axis xyz="0 1 0"/>
  </joint>
</robot>
